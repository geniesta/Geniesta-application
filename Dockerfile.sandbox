# Geniesta 開発用サンドボックス。
# Claude Code CLI ＋ bun/node ツールチェーンを内包し、リポジトリをマウントして隔離環境で作業する。
# 安全方針: git 認証情報（~/.ssh, ~/.gitconfig）も gh CLI も入れない＝リモートへ push できない。
#           ANTHROPIC_API_KEY / GITHUB_TOKEN は実行時に env で渡す（イメージには焼かない）。
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates ripgrep jq python3 procps less \
  && rm -rf /var/lib/apt/lists/*

# bun（アプリのパッケージマネージャ）と Claude Code CLI（`sbx run claude` 相当）。
RUN npm install -g bun@1 @anthropic-ai/claude-code \
  && npm cache clean --force

# 非 root で作業（node ユーザーは node イメージに既定で存在）。
USER node
WORKDIR /work

# 既定はシェル。sandbox.sh が claude / dev / 任意コマンドを渡す。
CMD ["bash"]
