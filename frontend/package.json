    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
