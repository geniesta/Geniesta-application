# 本番(EC2)用 nginx 設定テンプレート。
# 公式 nginx イメージが起動時に envsubst で ${API_DOMAIN} を展開し、
# /etc/nginx/conf.d/default.conf として出力する（$host 等の nginx 変数は env 未定義なので保持される）。
#
# 役割: フロントは Vercel のため、ここは bff 専用ゲートウェイ + TLS 終端。

upstream bff {
    server bff:8080;
}

# ── HTTP(80): ACME チャレンジ + HTTPS へリダイレクト ──────────────────────────────
server {
    listen 80;
    server_name ${API_DOMAIN};
    server_tokens off;

    # Let's Encrypt の webroot 認証
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS(443): バックエンド API ──────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

    client_max_body_size 10m;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    # セキュリティヘッダー
    add_header X-Content-Type-Options "nosniff"                         always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000"             always;

    # CORS は bff(ALLOWED_ORIGIN) 側で付与する。プリフライト(OPTIONS)も bff が処理。

    # ── GraphQL API（BFF） ───────────────────────────────────────────────────────
    location /graphql {
        proxy_pass         http://bff;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # GraphQL Subscription（WebSocket）
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout 30s;
    }

    # ── BFF ヘルスチェック ────────────────────────────────────────────────────────
    location ~ ^/(healthz|readyz)$ {
        proxy_pass       http://bff;
        proxy_set_header Host $host;
        access_log       off;
    }
}
